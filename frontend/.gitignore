# ============================================================
#  EV Charge Hub — Frontend .gitignore
# ============================================================

# -- Dependencies --------------------------------------------
node_modules/
package-lock.json
.pnp
.pnp.js

# -- Environment & Secrets -----------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# -- Build Outputs -------------------------------------------
dist/
build/
out/
.vite/
.next/

# -- Vite Cache ----------------------------------------------
.vite/
vite.config.js.timestamp-*

# -- Logs ----------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -- Testing -------------------------------------------------
coverage/
.nyc_output/
*.lcov
/test-results/
/playwright-report/
/playwright/.cache/

# -- OS & Editor ---------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
!.vscode/extensions.json
*.suo
*.swp
*.swo

# -- TypeScript ----------------------------------------------
*.tsbuildinfo

# -- Misc ----------------------------------------------------
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
storybook-static/
