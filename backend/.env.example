PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/ev_charge_hub
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# Razorpay Test Credentials (Sandbox mode)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Notification Credentials (Ethereal test mode or standard SMTP)
EMAIL_SERVICE=ethereal
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_pass
EMAIL_FROM="EV Charge Hub <no-reply@evchargehub.local>"
