# ============================================================
#  EV Charge Hub — Root .gitignore
# ============================================================

# -- Dependencies --------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# -- Environment & Secrets -----------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
*.pem
*.key
*.crt

# -- Build Outputs -------------------------------------------
dist/
build/
out/
.next/
.nuxt/
.vite/

# -- Logs ----------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -- OS & Editor Junk ----------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -- IDEs & Editors ------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# -- Testing -------------------------------------------------
coverage/
.nyc_output/
*.lcov

# -- Misc ----------------------------------------------------
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
